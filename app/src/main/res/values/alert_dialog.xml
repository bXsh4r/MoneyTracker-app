<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="alertDialogTheme">
        <item name="android:windowBackground">@drawable/alert_dialog_window_night</item>
        <item name="android:textColorPrimary">@color/white</item>

        <item name="android:windowIsFloating">true</item>

        <item name="android:windowMinWidthMinor">350dp</item>

        <item name="buttonBarPositiveButtonStyle">@style/buttonColor</item>
        <item name="buttonBarNegativeButtonStyle">@style/buttonColor</item>
        <item name="buttonBarNeutralButtonStyle">@style/buttonColor</item>

    </style>

    <style name="buttonColor" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>

    </style>
</resources>